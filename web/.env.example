# Public Reown/WalletConnect project identifier. Create one at cloud.reown.com
# and add the deployed site origin to the project's allowlist.
VITE_WALLETCONNECT_PROJECT_ID=replace-with-your-reown-project-id
# AMap (Gaode) JS API key + 企业安全密钥 for the MapMonitor page
# (https://console.amap.com, Web端 JS API). Production engine:
# mainland-safe basemap boundaries. The security code is optional but
# recommended for enterprise keys. Without it the page falls back to
# OpenStreetMap for local development only.
# Copy real values into .env.local (gitignored) or Vercel env vars; never
# commit real keys here — this template file is tracked by git.
VITE_AMAP_KEY=replace-with-your-amap-js-api-key
VITE_AMAP_SECURITY_CODE=replace-with-your-amap-security-code
