# 32+ random bytes; provisioned privately on the US host, never commit real values.
IGIT_REPLICATION_JWT_HMAC=replace-with-a-random-32-byte-minimum-secret
# Mainnet chain ID. The reaper refuses to start unless this is injective-1.
CHAIN_ID=injective-1
# Contract used only by the TTL reaper to determine whether a CID is on chain.
CONTRACT=inj1replace_me
# The installer refuses to enable the reaper without CONTRACT. For a staged
# data-plane-only install before the mainnet contract exists, run
# `replication-install.sh --no-reaper`; do not use a testnet address in prod.
LCD=https://lcd.injective.network:443
IGIT_REPLICATION_MAX_BYTES=2147483648
IGIT_REPLICATION_RATE_PER_MINUTE=12
# Per-user/repository byte budget in each one-minute window.
IGIT_REPLICATION_BYTES_PER_MINUTE=4294967296
